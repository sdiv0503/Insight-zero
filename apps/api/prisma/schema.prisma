generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model AnalysisReport {
  id           String   @id @default(uuid())
  userId       String   // Stores the Clerk User ID
  dataSource   String   // Name of the CSV or PDF
  summary      String   // The LLM Root Cause Summary
  anomalyCount Int      // Number of anomalies found
  rawJson      Json     // The complete PySpark payload
  createdAt    DateTime @default(now())
}